#Include "minigui.ch"

PROCEDURE Turmas

	DEFINE WINDOW turma_1;
	           AT 0,0 ;
 				  WIDTH 660				;
              HEIGHT 370    ;
	           TITLE 'Cadastro de Turmas' 	;
				  ICON "TUTOR";
				  CHILD 				;
		        FONT 'ARIAL' SIZE 9;	
				  ON MAXIMIZE ThisWindow.Center ;
		        ON INIT ( Abrirturma(),Desactivturma(),Actualizarturma())

		DEFINE TOOLBAR ToolBar_1 BUTTONSIZE 59,35 FLAT BORDER

			BUTTON PRIMERO 		;
				CAPTION '&Primero' 	;
				PICTURE 'primero'	;
				ACTION If(turma_1.Browse_1.value=1,MsgBox("Inicio do Arquivo"),turma_1.Browse_1.value:=1)

			BUTTON ANTERIOR 	;
				CAPTION '&Anterior' 	;
				PICTURE 'anterior'	;
				ACTION If(turma_1.Browse_1.value>1,turma_1.Browse_1.value:=turma_1.Browse_1.value-1,MsgInfo("Inicio de Dados"))

			BUTTON SIGUIENTE	;
				CAPTION '&Proximo' 	;
				PICTURE 'siguiente'	;
				ACTION (turma_1.Browse_1.value:=turma_1.Browse_1.value+1)

			BUTTON ULTIMO 		;
				CAPTION '&Ultimo' 	;
				PICTURE 'ultimo'	;
				ACTION (turma_1.Browse_1.value:=nCounter)  SEPARATOR

			BUTTON BUSCAR 		;
				CAPTION '&Pesquisa' 	;
				PICTURE 'buscar'	;
				ACTION Buscarturma()

			BUTTON Nuevo 		;
				CAPTION '&Novo' 	;
				PICTURE 'nuevo'	;
				ACTION (turma_1.nuevo.enabled:=.t.,turma_1.editar.enabled:=.f.,Nuevoturma())

			BUTTON EDITAR 		;
				CAPTION 'A&lterar' 	;
				PICTURE 'editar'	;
				ACTION (turma_1.nuevo.enabled:=.F.,turma_1.editar.enabled:=.T.,Activarturma())

			BUTTON ELIMINAR 	;
				CAPTION 'De&letar'	;
				PICTURE 'borrar'	;
				ACTION Eliminarturma() 

			BUTTON IMPRIMIR 	;
				CAPTION '&Imprimir'	;
				PICTURE 'imprimir2' ;
				ACTION (Imprimirturma()) 

			BUTTON CERRAR 	;
				CAPTION '&Fecha'	;
				PICTURE 'cerrar' ;
            ACTION turma_1.release
            
		END TOOLBAR

            @ 56,10 Grid Browse_1				;
		        	     WIDTH 230 				;
                    HEIGHT 230                            ; 
			           HEADERS { 'Codigo' , 'Descrição ' , "Inicio" , "Fim" }	;
		        	     WIDTHS { 55, 195, 100, 100}			;
			           ON CHANGE Actualizarturma() ;
			           ON DBLCLICK ( Activarturma() , Desactivturma() )
		
                     @ 70,240 LABEL Label_CODPRO;
                              VALUE 'Codigo';
						          	WIDTH 100           ;
                              HEIGHT 30           ;
	                           FONT 'Arial' SIZE 09	
 
                     @ 100,240 LABEL Label_DESPRO;
                             VALUE 'Descrição';
                             WIDTH 100           ;
                             HEIGHT 30           ;
	                         FONT 'Arial' SIZE 09

                     @ 130,240 LABEL h_inc;
                             VALUE 'Horario';
                             WIDTH 100           ;
                             HEIGHT 30           ;
	                          FONT 'Arial' SIZE 09
                                                         
                    @ 70,310 TEXTBOX T_CODPRO
							 
                    @ 100,310 TEXTBOX T_DESPRO;
                             OF turma_1 ;
		                      WIDTH 300			;
                            TOOLTIP 'Descrição do turmao' ;
                            MAXLENGTH 30 ;
                            UPPERCASE         

                    @ 130,310 TEXTBOX T_hinc;
                            OF turma_1 ;
		                      WIDTH 60			;
                            TOOLTIP 'Horario Inicial' 

                    @ 130,375 LABEL h_AA;
                             VALUE 'A';
                             WIDTH 30           ;
                             HEIGHT 30           ;
	                          FONT 'Arial' SIZE 09
	                          
                    @ 130,400 TEXTBOX T_hfim;
                            OF turma_1 ;
		                      WIDTH 60		;
                            TOOLTIP 'Horario Final' 
									 									        
                    @ 180,310 BUTTON Btn_Sturma Of turma_1        ;
                              CAPTION '&Salvar'             ;
                              ACTION Grava_Turma();
                              WIDTH 100 HEIGHT 27         ;
                              FONT "Arial" SIZE 09          ;
                              TOOLTIP "Salvar Registro" ;
                            FLAT

                    @ 180,470 BUTTON Btn_Cturma Of turma_1        ;
                              CAPTION '&Cancelar'		;
                              ACTION Cancelarturma() ;
		                      WIDTH 100 HEIGHT 27		;
                              FONT "Arial" SIZE 09		;
                              TOOLTIP "Cancelar Operação"	;
			                FLAT

	END WINDOW

   turma_1.Browse_1.SetFocus
		
	turma_1.CENTER 

	turma_1.ACTIVATE  

RETURN

*------------------------------------------------------------------------------*
PROCEDURE Abrirturma()
*------------------------------------------------------------------------------*
Local oRow
Local i
Local oQuery
LOCAL nCounter:= 0
LOCAL oQueryUp

DELETE ITEM ALL FROM Browse_1 Of turma_1

oQuery := oServer:Query( "Select codpro,despro,hinc,hfim From escola.turma ORDER BY despro" )
 
For i := 1 To oQuery:LastRec()
    nCounter++
    oRow := oQuery:GetRow(i)
    ADD ITEM { str(oRow:fieldGet(1),6,2), oRow:fieldGet(2), oRow:fieldGet(3), oRow:fieldGet(4)} TO Browse_1 Of turma_1
    oQuery:Skip(1)
Next
oQuery:Destroy()
turma_1.Browse_1.value:=1  
turma_1.Browse_1.SetFocus  
Return NIL

*------------------------------------------------------------------------------*
PROCEDURE Desactivturma()
*------------------------------------------------------------------------------*
        turma_1.Browse_1.Enabled:= .T.
        turma_1.T_CODPRO.Enabled:=.F.
	     turma_1.T_DESPRO.Enabled:=.F.
	     turma_1.T_hinc.Enabled:=.F.
        turma_1.T_hfim.Enabled:=.F.
        turma_1.Btn_Cturma.Enabled:= .F.
	     turma_1.Btn_Sturma.Enabled:= .F.
        turma_1.ToolBar_1.Enabled:= .T.
        turma_1.Browse_1.SetFocus

RETURN
*------------------------------------------------------------------------------*
PROCEDURE Activarturma()
*------------------------------------------------------------------------------*

        turma_1.Browse_1.Enabled:= .F.
	     turma_1.ToolBar_1.Enabled:= .F.
	     turma_1.T_CODPRO.Enabled:=.F.
        turma_1.T_DESPRO.Enabled:=.T.
        turma_1.T_hinc.Enabled:=.t.
        turma_1.T_hfim.Enabled:=.t.
        turma_1.Btn_Cturma.Enabled:= .T.
     	  turma_1.Btn_Sturma.Enabled:= .T.
RETURN
*------------------------------------------------------------------------------*
PROCEDURE Cancelarturma()
*------------------------------------------------------------------------------*

   turma_1.nuevo.enabled:=.T.
   turma_1.editar.enabled:=.T.
   
	Desactivturma()

	Actualizarturma()

	Nuevo := .F.

RETURN
*------------------------------------------------------------------------------*
PROCEDURE Grava_Turma()
*------------------------------------------------------------------------------*
LOCAL oQueryUp
LOCAL c_codigo:=PegaValorDaColuna( "BROWSE_1" , "turma_1" ,1)

If turma_1.nuevo.enabled == .T.
   cQuery:="INSERT INTO escola.turma (codpro,despro,hinc,hfim)"
   cQuery+=" values ('"+turma_1.T_CODPRO.VALUE+"','"+turma_1.T_DESPRO.value+"','"+turma_1.T_hinc.value+"','"+turma_1.T_hfim.value+"')"
   oQueryUp:=oServer:Query(cQuery)
Elseif turma_1.nuevo.enabled == .F.
   cQuery:="UPDATE escola.turma SET despro='"+turma_1.T_DESPRO.value
   cQuery+="',hinc='"+turma_1.T_hinc.value
   cQuery+="',hfim='"+turma_1.T_hfim.value
   cQuery+="' where codpro='"+c_codigo+"'"
   oQueryUp:=oServer:Query(cQuery)
EndIf

Abrirturma()   
   
turma_1.Browse_1.Refresh
turma_1.nuevo.enabled:=.T.
turma_1.editar.enabled:=.T.

Desactivturma()
Return
*------------------------------------------------------------------------------*
PROCEDURE Actualizarturma()
*------------------------------------------------------------------------------*
     	 turma_1.T_codpro.VALUE := PegaValorDaColuna( "BROWSE_1" , "turma_1",1)
       turma_1.T_despro.VALUE := PegaValorDaColuna( "BROWSE_1" , "turma_1",2)
       turma_1.T_hinc.value   := PegaValorDaColuna( "BROWSE_1" , "turma_1",3)     
       turma_1.T_hfim.value   := PegaValorDaColuna( "BROWSE_1" , "turma_1",4)
Return

*------------------------------------------------------------------------------*
Procedure Buscarturma()
*------------------------------------------------------------------------------*
Local Buscar
Local nOption:=0 
local nPos:=0
LOCAL i, j

nOption:=MsgOptions("Opçôes","Pesquisa","Users.Bmp" , {"&Codigo","&Descrição"}, 2, 20 )

  DO CASE
     CASE nOption=1
          Buscar := alltrim(InputBox( 'Informe Codigo' , 'Pesquisa' ) )  
          FOR i := 1 TO turma_1.Browse_1.ItemCount
              turma_1.Browse_1.value:=i
              if alltrim(PegaValorDaColuna( "BROWSE_1" , "turma_1",1)) = Buscar
                 nPos:=1
                 exit
              endif   
          NEXT i
     CASE nOPTION=2
          Buscar := AllTrim ( InputBox( 'Informe Descrição' , 'Pesquisa' ) )
          FOR i := 1 TO turma_1.Browse_1.ItemCount
              turma_1.Browse_1.value:=i
              if alltrim(PegaValorDaColuna( "BROWSE_1" , "turma_1",2)) = Buscar
                 nPos:=1
                 exit
              endif   
          NEXT i          
  ENDCASE 			  

IF nPos > 0
	turma_1.T_codpro.VALUE := PegaValorDaColuna( "BROWSE_1" , "turma_1",1)
   turma_1.T_despro.VALUE := PegaValorDaColuna( "BROWSE_1" , "turma_1",2)
   turma_1.T_hinc.value   := PegaValorDaColuna( "BROWSE_1" , "turma_1",3)   
   turma_1.T_hfim.value   := PegaValorDaColuna( "BROWSE_1" , "turma_1",4)
Else
   MsgExclamation('Não Encontrado Registro')
EndIf
   
turma_1.Browse_1.Refresh
       
Return
*------------------------------------------------------------------------------*
PROCEDURE Nuevoturma()
*------------------------------------------------------------------------------*
local oRow
Local i
Local oQuery
LOCAL nCounter:= 0
LOCAL oQueryUp

oQuery := oServer:Query( "Select codpro,despro,hinc,hfim From escola.turma ORDER BY codpro" )
 
For i := 1 To oQuery:LastRec()
    nCounter++
    oRow := oQuery:GetRow(i)
    oQuery:Skip(1)
Next                                                                                  
oQuery:Destroy()
nCounter++
turma_1.T_CODPRO.VALUE := STR(nCounter,6,2)
turma_1.T_DESPRO.VALUE := space(30) 
turma_1.T_hinc.value   := space(05)     
turma_1.T_hfim.value   := space(05)

Activarturma()

RETURN

*------------------------------------------------------------------------------*
Procedure Eliminarturma()
*------------------------------------------------------------------------------*
local cQuery
LOCAL c_codigo:=PegaValorDaColuna( "BROWSE_1" , "turma_1" ,1)
If MsgYesNo ( "Confirma Exclusão da Turma ?","Atenção")
   cQuery:= oServer:Query( "DELETE FROM escola.turma WHERE CODPRO='"+c_codigo+"'")
   cQuery:Destroy()
   Abrirturma()
	Actualizarturma()
EndIf
return 

*------------------------------------------------------------------------------*
Procedure Imprimirturma()
*------------------------------------------------------------------------------*
#include "winprint.ch"
Local dirimp:=GetCurrentFolder()
Local oRow
Local i
Local oQuery
LOCAL nCounter:= 0
LOCAL oQueryUp
Local A_Turmas:={}

Request HB_CODEPAGE_PT850

TITULOIMP:="Horarios Turmas"
 
INIT PRINTSYS
SELECT BY DIALOG PREVIEW

IF HBPRNERROR>0
   release printsys
   SetCurrentFolder(dirimp)
   return nil
ENDIF

oQuery := oServer:Query( "Select codpro,despro,hinc,hfim From escola.turma ORDER BY despro" )
 
For i := 1 To oQuery:LastRec()
    nCounter++
    oRow := oQuery:GetRow(i)
    AADD(A_Turmas,{ str(oRow:fieldGet(1),6,2), oRow:fieldGet(2), oRow:fieldGet(3), oRow:fieldGet(4)})
    oQuery:Skip(1)
Next
oQuery:Destroy()

HB_SETCODEPAGE( "PT850" )

SET UNITS MM
// Definição das fontes.
define font "ft08" name "times new roman" size 08
define font "ft10" name "times new roman" size 10
define font "ft12" name "times new roman" size 12 //bold=negrita
define font "ft14" name "times new roman" size 14
define font "ft18" name "times new roman" size 18

// Definição das Linhas.
define pen "p0" style PS_SOLID width 1 color 0x000000
define pen "p1" style PS_DOT width 1 color 0xFF0000
define pen "p2" style PS_NULL

set page orientation DMORIENT_PORTRAIT papersize DMPAPER_A4 font "ft10"
start doc name TituloImp
start page
   
PAG:=0
LH:=0

for i:=1 to len(A_Turmas)
   IF LH > 48 .OR. PAG=0   
      IF PAG<>0
         end page
         start page
      ENDIF
      PAG++
      LH:=1
      select font "ft12"
      @ LH,01 SAY Empresa[1]+space(70)+SUBSTR(DTOC(DATE()),1,6)+str(year(DATE()),4) TO PRINT
      LH+=8
      @ ++LH,55 SAY "Relatorio de Turmas" TO PRINT
      LH+=5
      select font "ft10"

      @ LH,00,LH+5,14 RECTANGLE
      @ LH,14,LH+5,56 RECTANGLE
      @ LH,56,LH+5,75 RECTANGLE
      @ LH,75,LH+5,95 RECTANGLE

      @ LH,01 SAY "Codigo" TO PRINT
	   @ LH,15 SAY "Descrição" TO PRINT
      @ LH,57 SAY "Hr.Inicial" TO PRINT
      @ LH,76 SAY "Hr.Final" TO PRINT

		LH+=5
	endif

   @ LH,00,LH+5,14 RECTANGLE
   @ LH,14,LH+5,56 RECTANGLE
   @ LH,56,LH+5,75 RECTANGLE
   @ LH,75,LH+5,95 RECTANGLE

   @ LH,01 SAY A_Turmas[i,1] TO PRINT
	@ LH,15 SAY A_Turmas[i,2] TO PRINT
   @ LH,62 SAY A_Turmas[i,3] TO PRINT
   @ LH,82 SAY A_Turmas[i,4] TO PRINT

	LH+=5
next	
end page
end doc
release printsys
SetCurrentFolder(dirimp)
RETURN NIL 

