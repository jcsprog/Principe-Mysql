Function G_Empresa()                     
*--------------------------------------------------------------*
Local oRow
Local i
Local oQuery
LOCAL oQueryUp
local nCounter:=0
oQuery := oServer:Query( "Select descr From arqemp" )
For i := 1 To oQuery:LastRec()
    nCounter++
    oRow := oQuery:GetRow(i)
    AADD(Empresa,oRow:fieldGet(1)) 
    oQuery:Skip(1)
Next
oQuery:Destroy()
Return NIL

