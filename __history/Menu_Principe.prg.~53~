Function Libera_modulo(vusuario,n_Modulo,S_solicita)
**********************************************************
local l_Libera:=.f.
local x_Texto:=space(10)
IF JCS->(DBSEEK(VUsuario+STR(n_Modulo,5)))
   do case  
      case jcs->adm==1  // administrador
           x_Texto:="administrador"
           l_Libera:=.t.
      case S_solicita == "I"
       	  x_Texto:="Inclusão"
   	     l_Libera:=JCS->INCLU
      case S_solicita == "A"
           x_Texto:="Alteração"
		     l_Libera:=JCS->ALTEU
	   case S_solicita == "E"
	        x_Texto:="Exclusão"
		     l_Libera:=JCS->EXCLU
	   case S_solicita == "P"
	        x_Texto:="Impressão"
			  l_Libera:=JCS->IMPRU
	endcase
ENDIF
if !l_Libera
   MSGINFO("Sem Liberação Para ("+x_Texto+") Solitice ao Administrador!!","Liberação de Modulos")
endif
RETURN (l_Libera)

