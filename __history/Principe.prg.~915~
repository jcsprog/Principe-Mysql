PROCEDURE Grava_Ra()
*------------------------------------------------------------------------------*
LOCAL oQueryUp
LOCAL cQuery
LOCAL c_codigo:=PegaValorDaColuna( "BROWSE_1" , "Aluno_1" ,1)

If Aluno_1.nuevo.enabled == .T.
   cQuery:="INSERT INTO escola.cad_alu (RA_ALUNO,CPF_ALU,DT_NASC,SEXO_ALU,END_ALU,BAI_ALU,"
   cQuery+="CID_ALU,CEP_ALU,FONE_1,FONE_2,NOME_ALU,COD_HOR,PROF_RESP,DTENTR,DTSAID,RG_ALU)"
   cQuery+=" values ('"+strzero(Aluno_1.N_RA.Value,10)+"','"+Aluno_1.C_CPF.Value+"','"+dtos(Aluno_1.D_dtnas.Value)
   cQuery+="','"+str(Aluno_1.C_sexo.Value,1)+"','"+Aluno_1.C_END.Value+"','"+Aluno_1.C_BAI.Value
   cQuery+="','"+Aluno_1.C_CID.Value+"','"+Aluno_1.C_CEP.Value+"','"+Aluno_1.C_FONE1.value
   cQuery+="','"+Aluno_1.C_FONE2.Value+"','"+Aluno_1.C_nome.value+"','"+substr(Aluno_1.T_turma.displayvalue,1,6)
   cQuery+="','"+Aluno_1.T_profe.displayvalue+"','"+dtos(Aluno_1.D_dtentr.value)
	cQuery+="','"+dtos(Aluno_1.D_dtsaid.value)+"','"+Aluno_1.C_rgalu.value+"')"
   oQueryUp:=oServer:Query(cQuery) 
Elseif Aluno_1.nuevo.enabled == .F.
   cQuery:="UPDATE escola.cad_alu SET CPF_ALU='"+Aluno_1.C_CPF.Value+"',DT_NASC='"+dtos(Aluno_1.D_dtnas.Value)
   cQuery+="',SEXO_ALU='"+str(Aluno_1.C_sexo.Value,1)+"',END_ALU='"+Aluno_1.C_END.Value
	cQuery+="',BAI_ALU='"+Aluno_1.C_BAI.Value+"',CID_ALU='"+Aluno_1.C_CID.Value
	cQuery+="',CEP_ALU='"+Aluno_1.C_CEP.Value+"',FONE_1='"+Aluno_1.C_FONE1.value
   cQuery+="',FONE_2='"+Aluno_1.C_FONE2.Value+"',NOME_ALU='"+Aluno_1.C_nome.value
	cQuery+="',COD_HOR='"+substr(Aluno_1.T_turma.displayvalue,1,6)+"',PROF_RESP='"+Aluno_1.T_profe.displayvalue
	cQuery+="',DTENTR='"+dtos(Aluno_1.D_dtentr.value)+"',DTSAID='"+dtos(Aluno_1.D_dtsaid.value)
	cQuery+="',RG_ALU='"+Aluno_1.C_rgalu.value+"' where RA_ALUNO='"+c_codigo+"'"
	oQueryUp:=oServer:Query(cQuery) 
EndIf

AbrirAluno()   
   
