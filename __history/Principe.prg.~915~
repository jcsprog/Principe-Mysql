PROCEDURE AbrirAluno()
*------------------------------------------------------------------------------*
Local oRow
Local i
Local oQuery
LOCAL nCounter:= 0
LOCAL oQueryUp

DELETE ITEM ALL FROM Browse_1 Of Aluno_1

oQuery := oServer:Query( "Select ra_aluno,nome_alu From escola.cad_alu ORDER BY RA_ALUNO" )
 
For i := 1 To oQuery:LastRec()
    nCounter++
    oRow := oQuery:GetRow(i)
    ADD ITEM { oRow:fieldGet(1),oRow:fieldGet(2)} TO Browse_1 Of Aluno_1
    oQuery:Skip(1)
Next
oQuery:Destroy()
Aluno_1.Browse_1.value:=1  
Aluno_1.Browse_1.SetFocus  
G_Turmas()
G_Prof()
//MostraGet()
Return 
*------------------------------------------------------------------------------*
PROCEDURE G_Turmas()
*------------------------------------------------------------------------------*
Local oRow
Local i
Local oQuery
LOCAL nCounter:= 0
LOCAL oQueryUp

Aluno_1.T_turma.deleteallitems

oQuery := oServer:Query( "Select codpro,despro,hinc,hfim From escola.turma ORDER BY despro" )
 
For i := 1 To oQuery:LastRec()
    nCounter++
    oRow := oQuery:GetRow(i)
    ADD item (str(oRow:fieldGet(1),6,2)+"|"+substr(oRow:fieldGet(2),1,10)+"|"+oRow:fieldGet(3)+"|"+oRow:fieldGet(4)) TO T_turma Of Aluno_1
    oQuery:Skip(1)
Next
oQuery:Destroy()
Aluno_1.T_turma.Value := 1
Return

*------------------------------------------------------------------------------*
PROCEDURE G_Prof()
*------------------------------------------------------------------------------*
Local oRow
Local i
Local oQuery
LOCAL nCounter:= 0
LOCAL oQueryUp

Aluno_1.T_profe.deleteallitems
oQuery := oServer:Query( "Select Fanta From escola.cliente ORDER BY Fanta" )
 
For i := 1 To oQuery:LastRec()
    nCounter++
    oRow := oQuery:GetRow(i)
    ADD item oRow:fieldGet(1) TO T_profe Of Aluno_1
    oQuery:Skip(1)
Next
oQuery:Destroy()
Aluno_1.T_profe.Value := 1
Return
